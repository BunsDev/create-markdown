{
  "name": "create-markdown",
  "version": "2.0.2",
  "description": "Complete block-based markdown notes package - convenience bundle for @create-markdown packages",
  "author": "Val Alexander <val@viewdue.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BunsDev/create-markdown.git",
    "directory": "packages/create-markdown"
  },
  "homepage": "https://github.com/BunsDev/create-markdown",
  "bugs": {
    "url": "https://github.com/BunsDev/create-markdown/issues"
  },
  "keywords": [
    "markdown",
    "md",
    "blocks",
    "notes",
    "editor",
    "parser",
    "serializer",
    "react",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.cjs"
      }
    },
    "./preview": {
      "import": {
        "types": "./dist/preview.d.ts",
        "default": "./dist/preview.js"
      },
      "require": {
        "types": "./dist/preview.d.ts",
        "default": "./dist/preview.cjs"
      }
    },
    "./preview-mermaid": {
      "import": {
        "types": "./dist/preview-mermaid.d.ts",
        "default": "./dist/preview-mermaid.js"
      },
      "require": {
        "types": "./dist/preview-mermaid.d.ts",
        "default": "./dist/preview-mermaid.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup --config tsup.config.ts",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@create-markdown/core": "workspace:^",
    "@create-markdown/preview": "workspace:^",
    "@create-markdown/preview-mermaid": "workspace:^",
    "@create-markdown/react": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "shiki": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.11.1"
}
